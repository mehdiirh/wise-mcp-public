# Server-only HMAC key: the same random 64-character hex value as the backend.
# Required. Generate once with: python -c "import secrets; print(secrets.token_hex(32))"
# Never share this key with MCP users. No user API tokens belong in this file.
WISE_MCP_SIGNING_SECRET=

# API root, including /api.
WISE_API_BASE_URL=https://api.wise.ad/api
WISE_TIMEOUT_SECONDS=30
WISE_MAX_RESPONSE_BYTES=4194304
WISE_HOST=0.0.0.0
WISE_PORT=8000
# Add the exact MCP deployment hostname before exposing it behind your HTTPS proxy.
WISE_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
# Compose host port (the container always listens on 8000).
MCP_PORT=8080
